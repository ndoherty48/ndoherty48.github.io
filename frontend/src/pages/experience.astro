---
import { listedRoles } from '../catalogue';
import ContactCTA from '../components/ContactCTA.astro';
import List from '../components/List.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperiencePreview from '../components/Experience/ExperiencePreview.astro'

const roles = await listedRoles();
---

<BaseLayout
	title="Experience | Nathan Doherty"
	description="Learn about my most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Professional Experience"
				tagline="Below outlines my professional experience in Software Engineering"
				align="center"
			/>
			<List>
				{
					roles.map((post, i) => (
						<li>
							<ExperiencePreview job={post}/>
						</li>
					))
				}
			</List>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
