---
import { type CollectionEntry, render } from 'astro:content';

import { rolePages } from '../../catalogue';
import Pill from '../../components/Pill.astro';
import EntryLayout from '../../layouts/EntryLayout.astro';

interface Props {
	entry: CollectionEntry<'employment'>;
	scheduled: boolean;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
	const pages = await rolePages();
	return pages.map(({ entry, scheduled }) => ({
		params: { slug: entry.id },
		props: { entry, scheduled },
	}));
}

const { entry, scheduled } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
	title={entry.data.title}
	description={entry.data.description}
	noindex={scheduled}
	backHref="/experience/"
	backLabel="Experience"
	badge={entry.data.employer}
	align="center"
	tags={entry.data.tags}
	img={entry.data.img}
	imgAlt={entry.data.img_alt}
>
	<Pill slot="before-tags" variant="outline">{entry.data.startDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}{entry.data.endDate && ` - `+entry.data.endDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) || ' - Present'}</Pill>
	<Content />
</EntryLayout>
