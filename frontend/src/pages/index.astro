---
import { Image } from 'astro:assets';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeScreenCurrentRole from '../components/Home/HomeScreenCurrentRole.astro';
import HomeScreenMostRecentProjects from '../components/Home/HomeScreenMostRecentProjects.astro';

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, my name is Nathan Doherty"
					tagline="I am a Senior Software Engineer based in Northern Ireland."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Developer</Pill>
						<Pill><Icon icon="terminal-window" size="1.33em" /> DevOps</Pill>
						<Pill><Icon icon="rocket-launch" size="1.33em" /> AWS Certified Developer</Pill>
					</div>
				</Hero>

				<Image 
					width="1553" 
					height="873" 
					src="/assets/portrait.jpg" 
					alt="Nathan Doherty smiling in a university cap and gown"
					loading="eager"
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<HomeScreenCurrentRole/>			
			<HomeScreenMostRecentProjects/>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}
</style>
