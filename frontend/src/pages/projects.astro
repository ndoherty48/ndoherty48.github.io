---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/Portfolio/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
	.filter(x => x.data.hidden === false)
	.sort(
        (a, b) => {
            const aDate = a.data.lastModifiedDate?.valueOf() ?? a.data.publishDate.valueOf();
            const bDate = b.data.lastModifiedDate?.valueOf() ?? b.data.publishDate.valueOf();
            return bDate - aDate;
        }
    );
---

<BaseLayout
	title="Projects | Nathan Doherty"
	description="Learn about my most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Projects"
				tagline="Learn about my recent projects"
				align="center"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
