---
import { type CollectionEntry, render } from "astro:content";

import { latestActivity, projectPages } from "../../catalogue";
import EntryLayout from "../../layouts/EntryLayout.astro";

interface Props {
	entry: CollectionEntry<"projects">;
	scheduled: boolean;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
	const pages = await projectPages();
	return pages.map(({ entry, scheduled }) => ({
		params: { slug: entry.id },
		props: { entry, scheduled },
	}));
}

const { entry, scheduled } = Astro.props;
const { Content } = await render(entry);

const lastUpdated = latestActivity(entry).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<EntryLayout
	title={entry.data.title}
	description={entry.data.description}
	noindex={scheduled}
	backHref="/projects/"
	backLabel="Projects"
	badge={`Last Updated: ${lastUpdated}`}
	tags={entry.data.tags}
	img={entry.data.img_hidden ? undefined : entry.data.img}
	imgAlt={entry.data.img_alt}
>
	<Content />
</EntryLayout>
