---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPreview from '../components/Blogs/BlogPreview.astro';
import List from '../components/List.astro';

const posts = (await getCollection('blog'))
    .sort(
        (a, b) => {
            const aDate = a.data.lastModifiedDate?.valueOf() ?? a.data.publishDate.valueOf();
            const bDate = b.data.lastModifiedDate?.valueOf() ?? b.data.publishDate.valueOf();
            return bDate - aDate;
        }
    );
---

<BaseLayout title="Blog | Nathan Doherty" description="A list of all my blog post's">
    <div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Blog"
				align="center"
			/>
			<List>
				{
					posts.map((blog) => (
						<li>
                            <BlogPreview blog={blog} />
						</li>
					))
				}
			</List>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
