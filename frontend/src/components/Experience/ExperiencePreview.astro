---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	job: CollectionEntry<'employment'>;
}

const { data, id } = Astro.props.job;
---

<a class="card" href={`/experience/${id}`}>
	<span class="title">{data.title}</span>
	<Image
		src={data.img}
		alt={data.img_alt || ''}
		loading="lazy"
		decoding="async"
		width=1
		height=1
	/>
	<span class="date">
		{data.startDate.toLocaleDateString()} - {data.endDate?.toLocaleDateString() ?? "Present"}
	</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 11rem;
		width: 100%;
		background: var(--gray-900);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.title {
		width: 100%;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-100);
		text-align: center;
	}

	img {
		flex: 1;
		width: 100%;
		object-fit: contain;
		object-position: center;
		padding: 1rem;
		min-height: 0;
	}

	.date {
		padding: 0.5rem 1rem;
		text-align: center;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		img {
			padding: 2rem;
		}
	}
</style>
