---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside id="contact">
	<div class="stack gap-4 copy">
		<h2>Interested in working together?</h2>
		<p>I'm looking for my next senior engineering role from January 2027. If your team needs a hand building cloud-native software, I'd love to hear from you.</p>
	</div>
	<CallToAction href="https://linkedin.com/in/nathandoherty48">
		Get in Touch
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.copy {
		text-align: center;
		align-items: center;
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 18ch;
	}

	p {
		max-width: 46ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		.copy {
			text-align: left;
			align-items: flex-start;
		}

		h2 {
			font-size: var(--text-3xl);
		}

		p {
			font-size: var(--text-lg);
		}
	}
</style>
